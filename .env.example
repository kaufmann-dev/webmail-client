# PostgreSQL connection string
DATABASE_URL="postgres://postgres:postgres@localhost:5432/webmail"
# Public URL of the app (adapter-node and Better Auth)
ORIGIN="http://localhost:5173"
# Random secret for Better Auth, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
# Pocket ID issuer URL and OIDC client credentials
POCKET_ID_ISSUER="https://id.example.com"
POCKET_ID_CLIENT_ID=""
POCKET_ID_CLIENT_SECRET=""
# 32 random bytes, base64; encrypts stored mail passwords and tokens (`openssl rand -base64 32`)
CREDENTIALS_KEY=""
# Optional: Microsoft Entra app for Microsoft 365 mailboxes (e.g. university accounts)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# Optional (production): adapter-node request body limit, needed for attachments
BODY_SIZE_LIMIT="30M"
